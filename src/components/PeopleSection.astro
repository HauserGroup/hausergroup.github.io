---
import { profiles } from "../data/profiles";
import MemberPortrait from "./MemberPortrait.astro";
interface Props {
  alumni?: boolean;
  standalone?: boolean;
}
const { standalone = false, alumni = false } = Astro.props;
const Heading = standalone ? "h1" : "h2";
---

<section class="wrap people" id={alumni ? "alumni" : "people"}>
  <div class="head">
    <Heading>{alumni ? "Alumni" : "People"}</Heading>
  </div>
  <div class="crew">
    {profiles
      .filter((person) => Boolean(person.alumni) === alumni)
      .map((person) => (
        <a
          class:list={["person", person.color]}
          href={`/people/${person.slug}/`}
        >
          <div class="frame">
            <i class="paper" aria-hidden="true"></i>
            <div class="portrait">
              <MemberPortrait
                src={person.portrait}
                initials={person.initials}
                eager={standalone}
              />
              <span class="open-profile" aria-hidden="true">
                ↗
              </span>
            </div>
          </div>
          <div>
            <p class="name">{person.name}</p>
            <p class="cap">{person.title}</p>
          </div>
        </a>
      ))}
  </div>
</section>

<style>
  .person {
    --tilt: -2deg;
    text-decoration: none;
  }
  .person:nth-child(4n + 2) {
    --tilt: 1.6deg;
  }
  .person:nth-child(4n + 3) {
    --tilt: -1deg;
  }
  .person:nth-child(4n) {
    --tilt: 2.2deg;
  }
  /* Each portrait is pasted on a sheet of its person's color, slightly askew. */
  .frame {
    position: relative;
    margin: 0 8px 8px 0;
  }
  .paper {
    position: absolute;
    inset: 0;
    background: var(--c);
    transform: translate(8px, 8px) rotate(var(--tilt));
    transition: transform 160ms ease-out;
  }
  .person:hover .paper,
  .person:focus-visible .paper {
    transform: translate(5px, 5px) rotate(0deg);
  }
  .portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border: 1.5px solid var(--ink);
    background: var(--t);
  }
  .open-profile {
    display: grid;
    place-items: center;
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--ink);
    background: var(--t);
    color: var(--ink);
    font: 20px/1 var(--f-mono);
  }
  .person:hover .name,
  .person:focus-visible .name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .person:hover .open-profile,
  .person:focus-visible .open-profile {
    background: var(--ink);
    color: white;
  }
</style>
