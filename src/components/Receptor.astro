---
// Cut-paper G protein-coupled receptor: seven helices crossing the membrane,
// a drug arriving from outside. Colors are the four primaries.
const lipidX = Array.from({ length: 25 }, (_, i) => 11 + i * 22);
const helices = [
  { x: 70, angle: -7, fill: "#1E4FC2" },
  { x: 140, angle: 5, fill: "#F6C51B" },
  { x: 210, angle: -3, fill: "#D92D1C" },
  { x: 280, angle: 8, fill: "#178553" },
  { x: 350, angle: -6, fill: "#1E4FC2" },
  { x: 420, angle: 3, fill: "#D92D1C" },
  { x: 490, angle: -9, fill: "#F6C51B" },
];
const loops = [
  "M55 152 C55 100 14 112 22 72 S62 34 40 12",
  "M151 152 C151 92 203 92 203 152",
  "M297 152 C297 66 337 66 337 152",
  "M426 152 C426 100 470 100 470 152",
  "M85 378 C85 432 129 432 129 378",
  "M216 378 C216 438 263 438 263 378",
  "M363 378 C363 462 413 462 413 378",
  "M510 378 C522 420 488 440 505 466",
];
---

<svg
  viewBox="0 0 560 470"
  role="img"
  aria-label="Cut-paper G protein-coupled receptor: seven colored helices crossing the membrane, with a drug arriving from outside"
>
  <defs>
    <pattern id="turns" patternUnits="userSpaceOnUse" width="50" height="20">
      <path
        d="M-5 22 L55 -2"
        stroke="#fff"
        stroke-opacity=".28"
        stroke-width="5"
      ></path>
    </pattern>
    <filter id="cut" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow
        dx="3"
        dy="4"
        stdDeviation="0"
        flood-color="#000"
        flood-opacity=".14"
      ></feDropShadow>
    </filter>
    <marker
      id="head"
      viewBox="0 0 10 10"
      refX="5"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 z" fill="#17171A"></path>
    </marker>
  </defs>

  <rect
    x="0"
    y="182"
    width="560"
    height="166"
    fill="#fff"
    fill-opacity=".55"
  ></rect>
  <g fill="#fff">
    {lipidX.map((cx) => (
      <circle cx={cx} cy="186" r="8" />
    ))}
    {lipidX.map((cx) => (
      <circle cx={cx} cy="344" r="8" />
    ))}
  </g>

  <g fill="none" stroke="#17171A" stroke-width="4.5" stroke-linecap="round">
    {loops.map((d) => (
      <path d={d} />
    ))}
  </g>

  <g filter="url(#cut)">
    {helices.map((h) => (
      <g transform={`rotate(${h.angle} ${h.x} 265)`}>
        <rect
          x={h.x - 25}
          y="140"
          width="50"
          height="250"
          rx="25"
          fill={h.fill}
        />
        <rect
          x={h.x - 25}
          y="140"
          width="50"
          height="250"
          rx="25"
          fill="url(#turns)"
        />
      </g>
    ))}
  </g>

  <path
    d="M252 76 C252 110 244 130 250 166"
    fill="none"
    stroke="#17171A"
    stroke-width="2"
    stroke-dasharray="5 6"
    marker-end="url(#head)"
  ></path>
  <g transform="translate(236 38) rotate(-14)" filter="url(#cut)">
    <polygon
      points="0,-20 17.3,-10 17.3,10 0,20 -17.3,10 -17.3,-10"
      fill="#17171A"
    ></polygon>
    <rect x="16" y="-3.5" width="18" height="7" fill="#17171A"></rect>
    <polygon
      points="46,-13 58.4,-4 53.7,10.5 38.3,10.5 33.6,-4"
      fill="#17171A"
    ></polygon>
    <circle cx="17.3" cy="10" r="5.5" fill="#D92D1C"></circle>
  </g>
</svg>
