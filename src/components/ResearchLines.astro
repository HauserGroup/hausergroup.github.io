---
import { research, scaleNames } from "../data/site";
import ResearchIcon from "./ResearchIcon.astro";
const { detail = false } = Astro.props;
---

<section class="research" id="research">
  <div class="wrap">
    <div class="head">
      {detail ? <h1>Three Lines Of Work</h1> : <h2>Three Lines Of Work</h2>}
    </div>
    {detail && (
      <div class="model-intro">
        <h2>Predictive models</h2>
        <p>
          We use sequence, structure and pharmacology to choose variants,
          peptide–receptor pairs and signalling responses to study in the lab.
        </p>
      </div>
    )}
    <div class="works">
      {research.map((w) => (
        <article class="work">
          <div class:list={["tile", "dots", w.color]}>
            <ResearchIcon kind={w.icon} />
          </div>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          {detail && <p class="model-question">{w.modelQuestion}</p>}
          <div class="reach">
            {scaleNames.map((name) => (
              <span class:list={{ on: w.reach.includes(name) }}>{name}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
