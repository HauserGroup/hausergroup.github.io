---
const { standalone = false } = Astro.props;
---

<section class="wrap software" id="software">
  <div class="head">{standalone ? <h1>Software</h1> : <h2>Software</h2>}</div>
  <div class="tools">
    <article class="tool">
      <div class="tool-icon dots b">
        <svg
          viewBox="0 0 320 240"
          role="img"
          aria-label="Dose–response curve fitted through data points"
        >
          <path
            d="M30 20 V210 H305"
            fill="none"
            stroke="#17171A"
            stroke-width="3"
          ></path>
          <path
            d="M30 196 C100 196 140 180 165 120 S230 44 300 44"
            fill="none"
            stroke="#17171A"
            stroke-width="6"
          ></path>
          <g fill="#1E4FC2" stroke="#17171A" stroke-width="3">
            <circle cx="60" cy="191" r="13"></circle>
            <circle cx="120" cy="180" r="13"></circle>
            <circle cx="165" cy="118" r="13"></circle>
            <circle cx="210" cy="66" r="13"></circle>
            <circle cx="270" cy="46" r="13"></circle>
          </g>
        </svg>
      </div>
      <div class="tool-text">
        <h3>CurveBook</h3>
        <p>
          Curve fitting, biostatistics and scientific graphs, with data,
          analyses and notes kept together in one file you can send to a
          collaborator.
        </p>
        <div class="facts">
          <span>Rust</span>
          <span>alpha</span>
        </div>
        <a class="btn" href="https://hausergroup.github.io/curvebook/">
          CurveBook{" "}
          <span class="arr" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </article>

    <article class="tool">
      <div class="tool-icon dots y">
        <svg
          viewBox="0 0 320 240"
          role="img"
          aria-label="Score plot with two groups separated along the predictive component"
        >
          <path
            d="M160 20 V220 M20 120 H300"
            fill="none"
            stroke="#17171A"
            stroke-width="3"
            stroke-dasharray="8 9"
          ></path>
          <g fill="#fff" stroke="#17171A" stroke-width="3.5">
            <circle cx="78" cy="88" r="15"></circle>
            <circle cx="106" cy="140" r="15"></circle>
            <circle cx="66" cy="150" r="15"></circle>
          </g>
          <g fill="#F6C51B" stroke="#17171A" stroke-width="3.5">
            <rect x="200" y="70" width="28" height="28"></rect>
            <rect x="236" y="120" width="28" height="28"></rect>
            <rect x="196" y="140" width="28" height="28"></rect>
          </g>
        </svg>
      </div>
      <div class="tool-text">
        <h3>scikit-opls</h3>
        <p>
          OPLS, OPLS-DA and O2PLS with a scikit-learn interface, plus VIP
          scores, S-plots and permutation tests.
        </p>
        <div class="facts">
          <span>Python</span>
          <span>v0.2.0</span>
        </div>
        <a class="btn y" href="https://hausergroup.github.io/scikit-opls/">
          scikit-opls{" "}
          <span class="arr" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </article>
  </div>
</section>
