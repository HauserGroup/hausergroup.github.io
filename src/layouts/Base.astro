---
import "../styles/site.css";
import Logo from "../components/Logo.astro";
import { GROUP_PAGE } from "../data/site";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  SITE_NAME,
  type JsonLd,
} from "../data/structuredData";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "profile";
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: JsonLd | JsonLd[];
}

// Keep the header short: the homepage tells the story, the rest is in the footer.
const mainLinks = [
  ["Research", "/#research"],
  ["Publications", "/publications/"],
  ["People", "/people/"],
  ["Join us", "/opportunities/"],
];
const moreLinks = [
  ["About", "/about/"],
  ["Software", "/software/"],
  ["Contact", "/contact/"],
  ["News", "/news/"],
  ["Alumni", "/alumni/"],
  ["Services", "/services/"],
];
const active = (href: string) =>
  Astro.url.pathname.startsWith(href) ? "page" : undefined;
const {
  title = "Hauser Group · Pharmacoinformatics",
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  ogType = "website",
  ogImage,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://hausergroup.org");
const canonicalUrl = noindex
  ? undefined
  : new URL(Astro.url.pathname, siteOrigin).href;
const resolvedOgImage = new URL(ogImage ?? DEFAULT_OG_IMAGE, siteOrigin).href;
const twitterCard = ogImage ? "summary" : "summary_large_image";
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geologica:SHRP,wght@100,400..600&family=Inter+Tight:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    {jsonLdBlocks.map((block) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(block).replaceAll("<", "\\u003c")}
      />
    ))}
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="wrap top">
      <a class="mark" href="/">
        <Logo width={48} />
        Hauser Group
      </a>
      <div class="top-right">
        <nav aria-label="Main">
          {mainLinks.map(([label, href]) => (
            <a href={href} aria-current={active(href)}>
              {label}
            </a>
          ))}
        </nav>
        <a class="btn" href={GROUP_PAGE}>
          Group page at UCPH{" "}
          <span class="arr" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="wrap foot cap">
      <nav aria-label="Additional categories">
        {moreLinks.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
      <span>Hauser Group · Pharmacoinformatics</span>
      <span>
        Department of Drug Design and Pharmacology, University of Copenhagen
      </span>
    </footer>
  </body>
</html>
