---
import Base from "../layouts/Base.astro";
import ParticleReceptor from "../components/ParticleReceptor.astro";
import Statement from "../components/Statement.astro";
import Scales from "../components/Scales.astro";
import Software from "../components/Software.astro";
import LatestPapers from "../components/LatestPapers.astro";
import PeopleSection from "../components/PeopleSection.astro";
import { joinOptions } from "../data/site";
import { organizationJsonLd, websiteJsonLd } from "../data/structuredData";

const siteOrigin = Astro.site ?? new URL("https://hausergroup.org");
---

<Base jsonLd={[organizationJsonLd(siteOrigin), websiteJsonLd(siteOrigin)]}>
  <section class="wrap hero">
    <div class="sky dots b cut-bottom">
      <div class="sim">
        <ParticleReceptor />
        <p class="sticker">
          <i class="tape" aria-hidden="true"></i>
          <b>34%</b>
          of approved drugs act on a G protein-coupled receptor.
        </p>
      </div>
      <h1>Every Genome Reads The Same Drug Differently</h1>
      <p class="hero-lead">
        At the University of Copenhagen we combine genomics, structural biology,
        pharmacology and health-care data to learn how human genetic variation
        changes the way receptors respond to drugs.
      </p>
    </div>
  </section>

  <Statement />

  <Scales />

  <LatestPapers />

  <Software />

  <PeopleSection />

  <section class="join-sheet dots y cut-top" id="join">
    <div class="wrap join-inner">
      <h2>Work With Us</h2>
      <ul class="join-list">
        {joinOptions.map(({ title, short, label, href }) => (
          <li>
            <h3>{title}</h3>
            <p>{short}</p>
            <a class="text-link" href={href}>
              {label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Closing sheet with a cut top edge, in the hero's halftone texture but
     yellow. The dots are densest at the bottom, mirroring the hero. */
  .join-sheet {
    margin-top: 96px;
    background: var(--t);
    color: var(--ink);
  }
  .join-inner {
    padding-block: 112px 88px;
    display: grid;
    gap: 48px;
  }
  .join-sheet h2 {
    font-size: clamp(3.2rem, 9vw, 8.6rem);
    line-height: 0.85;
  }
  .join-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }
  .join-list li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }
  .join-list h3 {
    font-size: 1.35rem;
  }
  .join-list p {
    font-size: 15px;
    line-height: 1.45;
  }
  .join-list .text-link {
    margin-top: auto;
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 1000px) {
    .join-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .join-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .join-inner {
      padding-block: 80px 64px;
    }
  }
</style>
