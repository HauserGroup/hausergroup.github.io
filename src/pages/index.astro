---
import Base from "../layouts/Base.astro";
import ParticleReceptor from "../components/ParticleReceptor.astro";
import Mission from "../components/Mission.astro";
import Scales from "../components/Scales.astro";
import ResearchLines from "../components/ResearchLines.astro";
import Software from "../components/Software.astro";
import LatestPapers from "../components/LatestPapers.astro";
import PeopleSection from "../components/PeopleSection.astro";
import { GROUP_PAGE } from "../data/site";
---

<Base>
  <section class="wrap hero">
    <div class="sky dots b">
      <div class="win w1">
        <div class="win-bar">
          mission.txt<span class="stripes"></span>
        </div>
        <div class="win-body">
          We integrate genomics, structural biology, pharmacology and
          health-care data to find new drug targets.
        </div>
      </div>
      <div class="win w2">
        <div class="win-bar">
          fact<span class="stripes"></span>
        </div>
        <div class="win-body">
          <b>34%</b>of approved drugs act on a G protein-coupled receptor.
        </div>
      </div>
      <ParticleReceptor />
      <h1>Every Genome Reads The Same Drug Differently</h1>
    </div>
    <p class="cap accent">
      Pharmacoinformatics, Department of Drug Design and Pharmacology,
      University of Copenhagen
    </p>
  </section>

  <Mission />

  <LatestPapers />

  <Scales />

  <ResearchLines />

  <Software />

  <PeopleSection />

  <section class="wrap" id="join">
    <div class="panel dots y">
      <div class="join-heading">
        <h2>Work With Us</h2>
        <a class="text-link" href="/opportunities/">
          Positions and research visits <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="win">
        <div class="win-bar">
          join.txt<span class="stripes"></span>
        </div>
        <div class="win-body">
          Thesis, PhD or postdoc between computation and the lab? Find the group
          on the department's website.
          <br />
          <br />
          <a class="btn" href={GROUP_PAGE}>
            Group page at UCPH{" "}
            <span class="arr" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
