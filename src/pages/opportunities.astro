---
import CategoryPage from "../components/CategoryPage.astro";
import { joinOptions } from "../data/site";
---

<CategoryPage
  title="Work With Us"
  description="Join the Hauser Group in Copenhagen: PhD fellowships, postdoctoral positions, MSc and exchange thesis projects, visiting researchers and collaborations in GPCR pharmacoinformatics."
  tone="y"
>
  <div class="option-grid">
    {joinOptions.map(({ title, body, label, href, color }) => (
      <article class:list={["option", color]}>
        <h2>{title}</h2>
        <p>{body}</p>
        <a class="text-link" href={href}>
          {label} <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</CategoryPage>
