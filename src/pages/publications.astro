---
import CategoryPage from "../components/CategoryPage.astro";
import { hauserScholar, hauserOrcid } from "../data/profiles";

import { publicationSections as sections } from "../data/publications";
---

<CategoryPage title="Publications" tone="g">
  <nav class="publication-sections" aria-label="Publication sections">
    {sections.map((section) => (
      <a href={"#" + section.id}>{section.title} ↓</a>
    ))}
  </nav>
  {sections.map((section) => (
    <section
      class="publication-section"
      id={section.id}
      aria-labelledby={section.id + "-heading"}
    >
      <h2 id={section.id + "-heading"}>{section.title}</h2>
      <ul class="paper-list" role="list">
        {section.papers.map((paper) => (
          <li>
            <a href={"https://doi.org/" + paper.doi}>
              <span class="paper-year">{paper.year}</span>
              <span>
                <small>
                  {paper.journal}
                  {paper.preprint && " · PREPRINT — NOT PEER REVIEWED"}
                </small>
                <strong>{paper.title}</strong>
                <span class="paper-authors">{paper.authors}</span>
                {"credit" in paper && (
                  <span class="paper-credit">{paper.credit}</span>
                )}
                {"note" in paper && (
                  <span class="paper-note">{paper.note}</span>
                )}
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <div class="publication-footer">
    <nav class="publication-links" aria-label="More publication records">
      <a class="text-link" href="/people/">
        Browse records by group member →
      </a>
      <a class="text-link" href={hauserScholar}>
        Alexander Hauser on Google Scholar ↗
      </a>
      <a class="text-link" href={hauserOrcid}>
        ORCID ↗
      </a>
    </nav>
  </div>
</CategoryPage>

<style>
  .publication-intro {
    max-width: 66ch;
    font-size: 1.2rem;
    line-height: 1.55;
    margin: 0 0 26px;
  }
  .publication-sections,
  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .publication-sections {
    margin-bottom: 52px;
    font: 500 13px/1.5 var(--f-mono);
  }
  .publication-sections a {
    text-underline-offset: 5px;
  }
  .publication-section {
    scroll-margin-top: 110px;
    margin-bottom: 58px;
  }
  .publication-section h2 {
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    margin-bottom: 12px;
  }
  .section-description {
    max-width: 74ch;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 24px;
  }
  .paper-authors,
  .paper-credit,
  .paper-note {
    display: block;
    line-height: 1.5;
  }
  .paper-authors {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .paper-credit {
    margin-top: 5px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .paper-note {
    margin-top: 5px;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .paper-year {
    align-self: start;
    padding-top: 3px;
  }
  .publication-footer {
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  @media (max-width: 700px) {
    .publication-sections {
      gap: 12px 20px;
      margin-bottom: 38px;
    }
    .paper-list strong {
      font-size: 1.25rem;
      line-height: 1.25;
    }
    .paper-authors {
      font-size: 0.85rem;
    }
  }
</style>
